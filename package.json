{
  "name": "wordle-nuxt",
  "type": "module",
  "private": true,
  "scripts": {
    "build:server": "BUILD_FORMAT=server nuxt build",
    "build:client": "BUILD_FORMAT=client nuxt generate",
    "build": "BUILD_FORMAT=fullstack nuxt build",
    "dev": "nuxt dev",
    "prepare": "node scripts/prepare.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate:dev": "drizzle-kit push --config drizzle.config.dev.ts",
    "db:migrate:prod": "drizzle-kit push --config drizzle.config.prod.ts",
    "nuke": "node scripts/nuke.js"
  },
  "dependencies": {
    "@libsql/client": "^0.15.15",
    "defu": "^6.1.4",
    "drizzle-orm": "^0.44.7",
    "drizzle-seed": "^0.3.1",
    "luxon": "^3.7.2",
    "nanoid": "^5.1.6",
    "nuxt": "^4.2.1",
    "serve": "^14.2.5",
    "valibot": "^1.1.0",
    "vue": "^3.5.24",
    "vue-router": "^4.6.3",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@libsql/darwin-arm64": "^0.5.22",
    "@libsql/linux-x64-gnu": "^0.5.22",
    "@types/luxon": "^3.7.1",
    "@unocss/nuxt": "^66.5.6",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.6",
    "eslint": "^9.39.1",
    "eslint-config-vuetify": "4.2.1-beta.1",
    "eslint-plugin-drizzle": "^0.2.3",
    "nuxt-auth-utils": "^0.5.25",
    "uncrypto": "^0.1.3",
    "unocss": "^66.5.6"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  }
}
